# ---------- Browser (safe to expose; protected by RLS) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- Server only (Vercel env vars, NEVER prefix with VITE_) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LLM_API_KEY=your-openai-compatible-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Minimum cosine similarity for retrieval (0.30 suits text-embedding-3-small; raise it for stricter matching)
RAG_MIN_SIMILARITY=0.30
